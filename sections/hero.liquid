<section class="hero hero--fusion{% if section.settings.image != blank %} hero--has-image{% endif %}"{% if section.settings.image != blank %} style="--hero-image:url('{{ section.settings.image | image_url: width: 2200 }}')"{% endif %}>
  <div class="page-width hero-inner">
    <div class="hero-copy">
      {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1>{{ section.settings.heading | escape }}</h1>
      {% if section.settings.text != blank %}<div class="hero-text">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>{% endif %}
      <p class="hero-note">{{ section.settings.note | escape }}</p>
    </div>
    {% unless section.settings.image != blank %}
      <div class="hero-art" aria-label="Sports nutrition products graphic" role="img">
        <div class="hero-orbit"></div><div class="hero-can"><span>SF</span><strong>FUEL<br>YOUR<br>FIRE</strong><small>SPORTS NUTRITION</small></div>
        <span class="hero-art-label">TRAIN · RECOVER · REPEAT</span>
      </div>
    {% endunless %}
  </div>
</section>
{% schema %}
{"name":"SparkFusion hero","settings":[{"type":"image_picker","id":"image","label":"Hero image (optional)"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"FUEL YOUR NEXT LEVEL"},{"type":"text","id":"heading","label":"Heading","default":"Built for the work you put in."},{"type":"richtext","id":"text","label":"Description","default":"<p>Discover sports nutrition made to move with you—from your first rep to your next personal best.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"SHOP ALL SUPPLEMENTS"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"note","label":"Small note","default":"QUALITY YOU CAN FEEL. RESULTS YOU EARN."}],"presets":[{"name":"SparkFusion hero"}]}
{% endschema %}
