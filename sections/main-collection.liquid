{% if section.settings.show_title %}<h1>{{ collection.title }}</h1>{% endif %}
<div class="page-width collection-template">
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="product-grid">
      {% for product in collection.products %}{% render 'product-card', product: product %}{% else %}<p>No products found.</p>{% endfor %}
    </div>
    {{ paginate | default_pagination }}
  {% endpaginate %}
</div>
{% schema %}
{"name":"Collection","settings":[{"type":"checkbox","id":"show_title","label":"Show title","default":true},{"type":"range","id":"products_per_page","label":"Products per page","min":4,"max":48,"step":4,"default":16}],"presets":[{"name":"Collection"}]}
{% endschema %}
