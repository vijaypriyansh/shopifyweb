<section class="brand-note section-space"><div class="page-width brand-note-inner"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="brand-note-copy">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} →</a>{% endif %}</div></section>
{% schema %}
{"name":"Brand statement","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"YOUR ROUTINE. YOUR RULES."},{"type":"text","id":"heading","label":"Heading","default":"Progress is built one day at a time."},{"type":"richtext","id":"text","label":"Text","default":"<p>Find the nutrition that fits your training, your goals and your life. Start with the basics, stay consistent, and make every session count.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"FIND YOUR FUEL"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Brand statement"}]}
{% endschema %}
