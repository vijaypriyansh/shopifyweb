<div class="page-width search-template">
  <h1>Search</h1>
  <form action="{{ routes.search_url }}" method="get">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products">
    <button class="button" type="submit">Search</button>
  </form>
  {% if search.performed %}
    <p>{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %}</p>
    <div class="product-grid">
      {% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% else %}<article><h2><a href="{{ item.url }}">{{ item.title }}</a></h2></article>{% endif %}{% endfor %}
    </div>
  {% endif %}
</div>
