<div class="announcement-bar"><div class="page-width announcement-inner"><span>{{ section.settings.text | escape }}</span>{% if section.settings.link_label != blank %}<a href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.link_label | escape }} →</a>{% endif %}</div></div>
{% schema %}
{"name":"Announcement bar","settings":[{"type":"text","id":"text","label":"Announcement","default":"FREE SHIPPING ON PREPAID ORDERS"},{"type":"text","id":"link_label","label":"Link text","default":"SHOP NOW"},{"type":"url","id":"link","label":"Link"}],"presets":[{"name":"Announcement bar"}]}
{% endschema %}
