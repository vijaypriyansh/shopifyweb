<section class="trust-strip"><div class="page-width trust-grid">
{% for block in section.blocks %}<div class="trust-item" {{ block.shopify_attributes }}><span class="trust-mark" aria-hidden="true">{{ block.settings.symbol | escape }}</span><div><strong>{{ block.settings.heading | escape }}</strong><p>{{ block.settings.text | escape }}</p></div></div>{% endfor %}
</div></section>
{% schema %}
{"name":"Trust points","blocks":[{"type":"point","name":"Trust point","settings":[{"type":"text","id":"symbol","label":"Icon / symbol","default":"✦"},{"type":"text","id":"heading","label":"Heading","default":"Made to perform"},{"type":"text","id":"text","label":"Description","default":"Fuel for your everyday goals"}]}],"max_blocks":4,"presets":[{"name":"Trust points","blocks":[{"type":"point","settings":{"symbol":"✦","heading":"MADE TO PERFORM","text":"Fuel for your everyday goals"}},{"type":"point","settings":{"symbol":"✓","heading":"QUALITY FIRST","text":"Thoughtful ingredients"}},{"type":"point","settings":{"symbol":"➜","heading":"DELIVERED TO YOU","text":"Shop securely online"}}]}]}
{% endschema %}
