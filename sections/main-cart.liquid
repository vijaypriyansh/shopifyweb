<div class="page-width cart-template">
  <h1>Your cart</h1>
  {% if cart.item_count == 0 %}<p>Your cart is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Continue shopping</a>{% else %}
    <form action="{{ routes.cart_url }}" method="post">
      {% for item in cart.items %}
        <div class="cart-line">
          {% if item.image %}{{ item.image | image_url: width: 180 | image_tag: loading: 'lazy' }}{% endif %}
          <div><a href="{{ item.url }}"><strong>{{ item.product.title }}</strong></a>{% if item.variant.title != 'Default Title' %}<p>{{ item.variant.title }}</p>{% endif %}</div>
          <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
          <strong>{{ item.final_line_price | money }}</strong>
        </div>
      {% endfor %}
      <button class="button secondary" type="submit" name="update">Update cart</button>
      <button class="button" type="submit" name="checkout">Check out</button>
    </form>
  {% endif %}
</div>
