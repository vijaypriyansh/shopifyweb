<section class="featured-products section-space">
  <div class="page-width">
    <div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
      {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">Shop collection <span aria-hidden="true">→</span></a>{% endif %}
    </div>
    {% assign chosen_collection = section.settings.collection %}
    {% if chosen_collection != blank and chosen_collection.products_count > 0 %}
      <div class="product-grid">
        {% for product in chosen_collection.products limit: section.settings.products_count %}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}{% endfor %}
      </div>
    {% elsif collections.all.products_count > 0 %}
      <div class="product-grid">
        {% for product in collections.all.products limit: section.settings.products_count %}{% render 'product-card', product: product, show_quick_add: section.settings.show_quick_add %}{% endfor %}
      </div>
      <p class="editor-hint">Showing products from your store. In Customize, choose a collection to feature a specific range.</p>
    {% else %}
      <div class="empty-products"><h3>Your next favorite is waiting.</h3><p>Add products in Shopify Admin, then select a collection for this section.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the store</a></div>
    {% endif %}
  </div>
</section>
{% schema %}
{"name":"Featured products","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE CROWD FAVORITES"},{"type":"text","id":"heading","label":"Heading","default":"Find your formula"},{"type":"collection","id":"collection","label":"Collection to feature"},{"type":"range","id":"products_count","label":"Products to show","min":2,"max":12,"step":1,"default":4},{"type":"checkbox","id":"show_quick_add","label":"Show add to cart buttons","default":true}],"presets":[{"name":"Featured products"}]}
{% endschema %}
