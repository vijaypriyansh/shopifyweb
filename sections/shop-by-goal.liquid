<section class="shop-goals section-space"><div class="page-width"><div class="section-heading"><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div></div><div class="goal-grid">
{% for block in section.blocks %}{% assign goal_collection = block.settings.collection %}<a class="goal-card goal-card--{{ forloop.index }}" href="{% if goal_collection != blank %}{{ goal_collection.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" {{ block.shopify_attributes }}>
{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: block.settings.title }}{% else %}<span class="goal-number">0{{ forloop.index }}</span>{% endif %}<span class="goal-overlay"><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.caption | escape }} →</span></span></a>{% endfor %}
</div></div></section>
{% schema %}
{"name":"Shop by goal","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"PICK YOUR PATH"},{"type":"text","id":"heading","label":"Heading","default":"What are you working toward?"}],"blocks":[{"type":"goal","name":"Goal card","settings":[{"type":"text","id":"title","label":"Title","default":"Build strength"},{"type":"text","id":"caption","label":"Link caption","default":"Explore products"},{"type":"collection","id":"collection","label":"Collection"},{"type":"image_picker","id":"image","label":"Image"}]}],"max_blocks":4,"presets":[{"name":"Shop by goal","blocks":[{"type":"goal","settings":{"title":"Build strength","caption":"PROTEIN + CREATINE"}},{"type":"goal","settings":{"title":"Train harder","caption":"PRE-WORKOUT + AMINOS"}},{"type":"goal","settings":{"title":"Recover better","caption":"DAILY RECOVERY"}}]}]}
{% endschema %}
